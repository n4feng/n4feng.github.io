# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

# Experiment tracker: source is public, runtime records and credentials are not.
!experiment-tracker/frontend/package-lock.json
experiment-tracker/**/.venv/
experiment-tracker/**/__pycache__/
experiment-tracker/**/.pytest_cache/
experiment-tracker/**/instance/
experiment-tracker/**/.env
experiment-tracker/**/*.sqlite*
experiment-tracker/**/*.db*
experiment-tracker/**/*.secret
